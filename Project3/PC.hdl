// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    //// Replace this comment with your code.
    Inc16(in=outreg, out=incout);
    Mux16(a=outreg, b=incout, sel=inc, out=loadinced);
    Mux16(a=loadinced, b=in, sel=load, out=loadin);
    Mux16(a=loadin, b=false, sel=reset, out=toReg);
    Or(a=load, b=inc, out=loadOrInc);
    Or(a=loadOrInc, b=reset, out=regLoad);
    Register(in=toReg, load=regLoad, out=out, out=outreg);
    
}
