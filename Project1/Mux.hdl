// File name: projects/1/Mux.hdl
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    // Invert sel using a NAND gate as an inverter
    Nand(a=sel, b=sel, out=notsel);
    Nand(a=a, b=notsel, out=notout1);
    Nand(a=b, b=sel, out=notout2);
    Nand(a=notout1, b=notout2, out=out);

}